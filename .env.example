# ============================================================
# AI集客支援サービス MVP - 環境変数サンプル
# ------------------------------------------------------------
# 何も設定しなくてもアプリは「インメモリ・モック」で起動します。
# （ダミーデータで一覧/詳細/各APIを試せます）
# 実データを使う場合のみ Supabase / LLM の値を設定してください。
# ============================================================

# --- Supabase（未設定ならインメモリ・モックにフォールバック） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバ側でのみ使用。RLSをバイパスするため絶対にクライアントへ出さない。
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM（未設定ならルールベース/テンプレートのみで動作） ---
# 既定プロバイダは Anthropic Claude。
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAIを使う場合（LLM_PROVIDER=openai）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 内部API保護用（任意。n8n等からの呼び出しヘッダ x-api-key と照合） ---
INTERNAL_API_KEY=

# --- Google Places API (New)（店舗取得機能で使用） ---
# 未設定の場合、/stores の「店舗取得」は503エラーを返します（他機能は動作）。
# 必要な有効化: Places API (New)。キーは places:searchText の呼び出しに使用。
GOOGLE_PLACES_API_KEY=

# --- ノイモスAI（ホームページ自動生成AI）連携 ---
# 未設定なら「ホームページ生成」は下書き（未接続）として動作し、
# ノイモスAIへ渡すブリーフ(契約)の確認のみ可能。接続時に本番生成が有効化される。
NEUMOS_API_URL=
NEUMOS_API_KEY=

# 仮デモサイトの公開ベースURL（将来の公開自動化で使用）
NEXT_PUBLIC_SITE_BASE_URL=http://localhost:3000
