# ============================================================
# Neumos AI v1 - 環境変数サンプル
# ------------------------------------------------------------
# 何も設定しなくてもルールベースの戦略生成のみ・インメモリ保存で起動します
# （ローカル開発向け）。Vercel等のサーバーレスにProductionデプロイする場合は
# 下記のSupabase設定が必須です（未設定だとインスタンス再起動やインスタンス切替で
# /preview/[requestId] が「見つかりません」になります）。
# ============================================================

# --- Supabase（Neumos AI v1専用DB。未設定ならインメモリにフォールバック） ---
# AI集客支援MVP側のSupabaseプロジェクトとは別物にすること
# （両サービスは疎結合で、DBを共有しない設計）。
# 1. Supabaseで新規プロジェクトを作成
# 2. supabase/schema.sql をSQL Editorで実行
# 3. Project Settings > API から以下を取得して設定
#    (SUPABASE_URLはサーバ専用のためNEXT_PUBLIC_接頭辞は不要。
#     NEXT_PUBLIC_SUPABASE_URLが設定されていればそちらも読み取る)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM（未設定ならルールベースのみで動作） ---
# 既定プロバイダは Anthropic Claude。
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAIへ切り替える場合（LLM_PROVIDER=openai）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Brand Director（新規・独立したprovider切替。未設定なら常にrule実装で動作） ---
# 既存のLLM_PROVIDER（コピー生成）とは別軸。generate.ts等の既存生成経路からは
# まだ呼ばれていないため、設定しなくても既存の挙動には一切影響しない。
# BRAND_DIRECTOR_PROVIDER=openai かつ OPENAI_API_KEY が両方揃った場合のみ有効。
BRAND_DIRECTOR_PROVIDER=rule

# モデルルーティング。コード側にモデル名の既定値は一切持たせていないため、
# 3つとも未設定の場合はOpenAIへ接続せず常にrule-providerへ安全にフォールバックする
# （STANDARDのみ設定した場合はPREMIUM/VISIONの既定値としてSTANDARDの値を使う）。
# STANDARD: 業種分類・コピー生成・構造化 / PREMIUM: ブランド方針・最終品質監査 / VISION: 写真分析
#
# 未確認のモデルIDをここに書かないこと。Phase2でVercel等の外向き通信が可能な環境から
# 実際に対象OpenAIアカウントで利用可能なモデルIDを確認し、そのアカウントの
# 環境変数へ直接設定すること（このサンプルファイルへ特定モデル名を固定しない）。
OPENAI_MODEL_STANDARD=
OPENAI_MODEL_PREMIUM=
OPENAI_MODEL_VISION=

# Vision入力の解像度detail。"low"（既定・低コスト）または"high"。
OPENAI_VISION_DETAIL=

# Brand DirectorのOpenAI呼び出しタイムアウト（ミリ秒）。未設定なら8000。
OPENAI_TIMEOUT_MS=

# previewUrl はリクエストのoriginから自動算出するため、追加設定は不要です。
