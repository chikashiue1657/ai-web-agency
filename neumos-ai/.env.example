# ============================================================
# Neumos AI v1 - 環境変数サンプル
# ------------------------------------------------------------
# 何も設定しなくてもルールベースの戦略生成のみ・インメモリ保存で起動します
# （ローカル開発向け）。Vercel等のサーバーレスにProductionデプロイする場合は
# 下記のSupabase設定が必須です（未設定だとインスタンス再起動やインスタンス切替で
# /preview/[requestId] が「見つかりません」になります）。
# ============================================================

# --- Supabase（Neumos AI v1専用DB。未設定ならインメモリにフォールバック） ---
# AI集客支援MVP側のSupabaseプロジェクトとは別物にすること
# （両サービスは疎結合で、DBを共有しない設計）。
# 1. Supabaseで新規プロジェクトを作成
# 2. supabase/schema.sql をSQL Editorで実行
# 3. Project Settings > API から以下を取得して設定
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM（未設定ならルールベースのみで動作） ---
# 既定プロバイダは Anthropic Claude。
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAIへ切り替える場合（LLM_PROVIDER=openai）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# previewUrl はリクエストのoriginから自動算出するため、追加設定は不要です。
