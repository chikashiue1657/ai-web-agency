# ============================================================
# Neumos AI v1 - 環境変数サンプル
# ------------------------------------------------------------
# 何も設定しなくてもルールベースの戦略生成のみで起動します。
# LLMキーを設定すると、同じ戦略を下敷きに文章の質をLLMで高めます。
# ============================================================

# --- LLM（未設定ならルールベースのみで動作） ---
# 既定プロバイダは Anthropic Claude。
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAIへ切り替える場合（LLM_PROVIDER=openai）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# previewUrl はリクエストのoriginから自動算出するため、追加設定は不要です。
