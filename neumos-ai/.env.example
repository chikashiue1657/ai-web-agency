# ============================================================
# Neumos AI v1 - 環境変数サンプル
# ------------------------------------------------------------
# 何も設定しなくてもルールベースの戦略生成のみ・インメモリ保存で起動します
# （ローカル開発向け）。Vercel等のサーバーレスにProductionデプロイする場合は
# 下記のSupabase設定が必須です（未設定だとインスタンス再起動やインスタンス切替で
# /preview/[requestId] が「見つかりません」になります）。
# ============================================================

# --- Supabase（Neumos AI v1専用DB。未設定ならインメモリにフォールバック） ---
# AI集客支援MVP側のSupabaseプロジェクトとは別物にすること
# （両サービスは疎結合で、DBを共有しない設計）。
# 1. Supabaseで新規プロジェクトを作成
# 2. supabase/schema.sql をSQL Editorで実行
# 3. Project Settings > API から以下を取得して設定
#    (SUPABASE_URLはサーバ専用のためNEXT_PUBLIC_接頭辞は不要。
#     NEXT_PUBLIC_SUPABASE_URLが設定されていればそちらも読み取る)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Generation API authentication (required; fail-closed when empty) ---
# Protects POST /v1/contents, GET /v1/contents/[requestId], and POST /api/generate.
NEUMOS_API_KEY=

# --- LLM（未設定ならルールベースのみで動作） ---
# 既定プロバイダは Anthropic Claude。
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAIへ切り替える場合（LLM_PROVIDER=openai）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Brand Director（新規・独立したprovider切替。未設定なら常にrule実装で動作） ---
# 既存のLLM_PROVIDER（コピー生成）とは別軸。generate.ts等の既存生成経路からは
# まだ呼ばれていないため、設定しなくても既存の挙動には一切影響しない。
# BRAND_DIRECTOR_PROVIDER=openai かつ OPENAI_API_KEY が両方揃った場合のみ有効。
BRAND_DIRECTOR_PROVIDER=rule

# モデルルーティング。コード側にモデル名の既定値は一切持たせていないため、
# 3つとも未設定の場合はOpenAIへ接続せず常にrule-providerへ安全にフォールバックする
# （STANDARDのみ設定した場合はPREMIUM/VISIONの既定値としてSTANDARDの値を使う）。
# 下記はOpenAI公式ドキュメントで存在を確認済みのモデルIDだが、実際に対象アカウントで
# 利用可能かはアカウントごとに異なるため、Phase2でVercel等の外向き通信が可能な環境から
# GET /api/admin/brand-director/models（診断エンドポイント。BRAND_DIRECTOR_DIAGNOSTIC_TOKEN
# 必須）で利用可否を確認したうえで設定すること。
#
# STANDARD: 業種分類・コピー生成・整形など低コストな構造化処理
# PREMIUM:  BrandPlan生成・判断が難しい店舗の分析・最終品質監査
# VISION:   写真分析・写真の役割選定
OPENAI_MODEL_STANDARD=gpt-5.6-luna
OPENAI_MODEL_PREMIUM=gpt-5.6-terra
OPENAI_MODEL_VISION=gpt-5.6-luna

# Vision入力の解像度detail。"low"（既定・低コスト）または"high"。
OPENAI_VISION_DETAIL=low

# --- v2 AI補助画像（任意・既定は無効） ---
# 実店舗写真が2枚未満のカフェで、生成時に世界観補助画像を最大1枚だけ作成します。
# 実店舗写真とは別表示となり、「AI生成イメージ」と明記されます。
SUPPLEMENTAL_IMAGE_PROVIDER=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
SUPPLEMENTAL_IMAGE_STORAGE_BUCKET=neumos-generated-assets

# Brand DirectorのOpenAI呼び出しタイムアウト（ミリ秒）。未設定なら8000。
OPENAI_TIMEOUT_MS=

# --- Brand Director診断ルート（/api/admin/brand-director/*。未設定なら常に401） ---
# GET /v1/models でのモデル利用可否確認、実OpenAI Responses APIでのBrandPlan取得を
# 手動確認するための一時的な管理者専用エンドポイント。十分に長いランダム値を設定し、
# リクエストヘッダー x-diagnostic-token に同じ値を渡した場合のみアクセスできる。
# 診断が完了したら、値を削除する（または該当ルート自体をコードから削除する）こと。
BRAND_DIRECTOR_DIAGNOSTIC_TOKEN=

# --- 問い合わせ180日削除cron（GET /api/internal/inquiries/cleanup。未設定なら常に404） ---
# PR: 問い合わせPIIの180日自動削除（PR #36とは別の独立PR。#36の
# neumos_site_inquiriesテーブルが前提。マージ順序はどちらが先でも可）。
# vercel.json の crons 定義がこのパスを1日1回叩く。Vercelは環境変数名が
# 厳密に"CRON_SECRET"の場合のみ、スケジュール実行時のリクエストへ自動的に
# Authorization: Bearer <値> を付与する（vercel.jsonのcrons定義にカスタム
# ヘッダーは指定できないため、この名前で統一する必要がある）。
# NEUMOS_API_KEY・INQUIRY_HASH_SALTと同じ値を設定しないこと
# （別の認証境界であり、使い回すと片方の漏洩がもう片方にも波及するため。
# 同じ値を設定した場合は起動時ではなくリクエスト時に検知し503を返す）。
CRON_SECRET=

# previewUrl はリクエストのoriginから自動算出するため、追加設定は不要です。
